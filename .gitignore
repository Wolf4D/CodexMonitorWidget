# ====================================================================
# Codex Monitor Widget (CMW) - .gitignore
# ====================================================================

# Build & Compilation directories
release/
debug/
build/
bin/
obj/

# Qt / QMake generated files
Makefile*
.qmake.stash
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*.qrc.depends

# Object & Resource binaries
*.o
*.obj
*.res
app_res.o

# Executables and Libraries
*.exe
*.dll
*.so
*.dylib
*.a
*.lib

# IDE & Editor files
.vscode/
.idea/
*.user
*.user.*
*.suo
*.sln
*.vcxproj
*.vcxproj.*

# Windows / OS metadata
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# Temporary & Log files
*.log
*.tmp
*.bak
*.swp
*~

# Track translation source and binary catalogs embedded in resources
!translations/*.ts
!translations/*.qm
